{
  "name": "@poster/api",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB API: auth, templates, uploads, Gemini art direction and Puppeteer poster rendering.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsup",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/scripts/smoke.ts",
    "test:gemini": "tsx src/scripts/test-gemini.ts",
    "samples": "tsx src/scripts/samples.ts",
    "render:demo": "tsx src/scripts/render-demo.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@poster/shared": "*",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "p-queue": "^9.3.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer": "^25.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
