# ─────────────────────────────────────────────────────────────────────────────
# AI Political Poster Maker — API configuration
# Copy to `.env`. Everything is optional in development: with no values the API starts
# an embedded MongoDB, stores files on disk and art-directs with curated colourways.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public URL of this API (used to build links to locally stored files) and the web origins allowed by CORS.
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Leave empty in development → embedded MongoDB (data kept in apps/api/.data).
# Production: MongoDB Atlas connection string.
MONGODB_URI=
MONGODB_DB=poster_maker

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── File storage ────────────────────────────────────────────────────────────
# auto = Cloudinary when the credentials below are present, otherwise the local ./uploads folder.
STORAGE_DRIVER=auto
# Either the single URL…
CLOUDINARY_URL=
# …or the three parts
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=poster-maker

# ── Gemini (AI art direction) ───────────────────────────────────────────────
# https://aistudio.google.com/apikey — without a key the app still works (curated colourways, local face-crop estimate).
GEMINI_API_KEY=
# "-latest" aliases follow Google's newest stable Flash model.
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TIMEOUT_MS=45000
# Optional: route Gemini calls through a proxy / gateway.
GEMINI_BASE_URL=
# Paint an AI background plate per template variant (one image call, then cached forever).
AI_BACKDROPS_ENABLED=false

# ── Product limits ──────────────────────────────────────────────────────────
MAX_REGENERATIONS=3
DAILY_POSTER_LIMIT=60
MAX_UPLOAD_MB=12
# Offset used to group the admin dashboard's per-day numbers (Bangladesh = +06:00).
STATS_TZ_OFFSET=+06:00

# ── Rendering ───────────────────────────────────────────────────────────────
RENDER_CONCURRENCY=2
RENDER_LOW_MEMORY=
# Path to Chrome / Chromium / Edge. Empty → Puppeteer's bundled Chrome, then system browsers.
CHROME_PATH=

# ── Seed (npm run seed) ─────────────────────────────────────────────────────
ADMIN_NAME=Poster Admin
ADMIN_EMAIL=admin@poster.local
ADMIN_PASSWORD=Admin@12345
